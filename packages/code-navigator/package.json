{
  "name": "dsh-code-navigator",
  "version": "0.1.0-alpha.20",
  "description": "Standalone persistent language-server navigation for DeepSeek Harness.",
  "keywords": ["deepseek-harness", "dsh", "lsp", "clangd", "pyright", "typescript", "code-navigation"],
  "author": "Islulua",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Islulua/dsh-code-navigator.git",
    "directory": "packages/code-navigator"
  },
  "homepage": "https://github.com/Islulua/dsh-code-navigator#readme",
  "bugs": { "url": "https://github.com/Islulua/dsh-code-navigator/issues" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "dsh.plugin.json", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-modules"], "platform": "web" }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:release": "pnpm run typecheck && pnpm run test && pnpm run build && publint",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "pyright": "^1.1.405",
    "schemastery": "^3.18.0",
    "typescript-language-server": "^5.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-fs": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-alpha.3"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-fs": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-lsp": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-lsp-stdio": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-subprocess": "0.1.2-alpha.3",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@lezer/highlight": "^1.2.3",
    "publint": "^0.3.16",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "5.7.0",
    "tsdown": "^0.22.14",
    "vitest": "^4.1.0"
  },
  "license": "MIT"
}
